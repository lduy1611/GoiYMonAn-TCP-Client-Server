# Copy this file to .env and replace every placeholder locally. Never commit .env.
UNIFIED_MYSQL_HOST=127.0.0.1
UNIFIED_MYSQL_PORT=3306
UNIFIED_MYSQL_USER=goiy_demo_app
UNIFIED_MYSQL_PASSWORD=replace-with-local-mysql-password
UNIFIED_MYSQL_DATABASE=goiy_demo_v3_test

# Local demo Admin; the launcher derives a PBKDF2 hash in memory.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-demo-admin-password

# Keep TCP and MySQL bound to localhost. WEB_HOST can be 0.0.0.0 for a trusted LAN only.
WEB_HOST=127.0.0.1
WEB_PORT=8000
TCP_HOST=127.0.0.1
TCP_PORT=9000
TCP_MAX_CONNECTIONS=4
UNIFIED_TCP_DB_POOL_SIZE=4
