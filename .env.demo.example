# Copy to .env only in a fresh clone; preserve existing local .env.
TCP_DB_SCHEMA=unified_v3
UNIFIED_SCHEMA_MODE=1
UNIFIED_MYSQL_HOST=127.0.0.1
UNIFIED_MYSQL_PORT=3306
UNIFIED_MYSQL_DATABASE=goiy_demo_test
UNIFIED_MYSQL_USER=goiy_demo
UNIFIED_MYSQL_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
UNIFIED_TCP_DB_POOL_SIZE=4
TCP_MAX_CONNECTIONS=4
TCP_HOST=127.0.0.1
TCP_PORT=9000
WEB_HOST=127.0.0.1
WEB_PORT=8000
TCP_LOG_PATH=statics/runtime/tcp_server.jsonl
FASTAPI_GATEWAY_LOG_PATH=statics/runtime/fastapi.jsonl
RECIPE_IMAGE_STORAGE_DIR=statics/runtime/recipe-images
MEAL_PLAN_STATE_DIR=statics/runtime/meal-state
# Generate a unique secret per installation; do not use this placeholder.
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_COOKIE_SECURE=false
USER_COOKIE_SECURE=false
# Optional environment Admin login; uncomment both and choose a private password.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_ADMIN_PASSWORD
